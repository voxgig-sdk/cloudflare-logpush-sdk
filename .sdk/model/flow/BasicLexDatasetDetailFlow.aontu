# BasicLexDatasetDetailFlow

main: kit: flow: BasicLexDatasetDetailFlow:
{
  entity: "lex_dataset_detail",
  kind: "basic",
  name: "BasicLexDatasetDetailFlow",
  step: [
    {
      i: {
        ref: "lex_dataset_detail_ref01"
      }

      m: {
        account_id: "account01",
        zone_id: "zone01"
      }

      o: "create"
    }

    {
      d: {
        zone_id: "zone01"
      }

      i: {
        ref: "lex_dataset_detail_ref01",
        srcdatavar: "lex_dataset_detail_ref01_data",
        suffix: "_up0",
        textfield: "dataset"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-lex_dataset_detail_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "lex_dataset_detail_ref01",
        srcdatavar: "lex_dataset_detail_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "lex_dataset_detail01",
        zone_id: "zone01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-lex_dataset_detail_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLexDatasetDetailFlow"
}